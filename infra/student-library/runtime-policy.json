{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StudentLibraryRecords",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DeleteItem",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:924225826927:table/novasprout-student-library"
      ]
    },
    {
      "Sid": "StudentLibraryList",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:924225826927:table/novasprout-student-library/index/student-updated"
      ]
    }
  ]
}
